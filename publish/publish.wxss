.publish { padding-bottom: 240rpx; }

.role-row { display: flex; gap: 20rpx; padding: 24rpx 28rpx; }
.role-card {
  flex: 1; background: rgba(255,255,255,0.88); border-radius: 24rpx;
  padding: 30rpx 20rpx; text-align: center; border: 4rpx solid transparent;
}
.role-active { border-color: #16a34a; background: #f0f9f3; }
.role-icon { font-size: 48rpx; }
.role-name { font-size: 32rpx; font-weight: 700; margin: 12rpx 0 8rpx; }
.role-desc { font-size: 22rpx; color: #8a9a90; line-height: 1.5; }

.field-label { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.line-input { font-size: 30rpx; padding: 12rpx 0; }
.textarea { width: 100%; height: 200rpx; font-size: 28rpx; box-sizing: border-box; }
.count { text-align: right; color: #9bb0a6; font-size: 22rpx; }

.map-placeholder {
  height: 180rpx; border-radius: 20rpx; background: #e6f2ec;
  display: flex; align-items: center; justify-content: center; color: #7d9689; font-size: 26rpx;
}
.chosen { color: #16a34a; margin-top: 16rpx; font-size: 26rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; }

/* 省 / 市 选择器 */
.region-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
  background: #f0f7f2;
  border-radius: 16rpx;
  margin: 10rpx 0 6rpx;
}
.region-picker-text { font-size: 30rpx; font-weight: 600; color: #23483a; }
.region-picker-arrow { font-size: 32rpx; color: #b6c6bd; }