.messages {
  padding-bottom: 40rpx;
}
.msg-head {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  padding: 28rpx 32rpx 8rpx;
  text-shadow: 0 2rpx 10rpx rgba(0,60,20,.35);
}
.chip-row {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 32rpx 24rpx;
}
.chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.75);
  color: #23483a;
}
.chip-active {
  background: #16a34a;
  color: #ffffff;
}
.msg-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  margin: 0 32rpx 16rpx;
  border-radius: 20rpx;
  padding: 24rpx;
}
.msg-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #f0f7f2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}
.msg-body {
  flex: 1;
}
.msg-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111;
}
.msg-desc {
  font-size: 24rpx;
  color: #444;
  margin-top: 6rpx;
}
.msg-time {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #666;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #f97316;
}
.empty {
  text-align: center;
  color: #333;
  background: rgba(255, 255, 255, 0.9);
  margin: 0 32rpx;
  padding: 80rpx 0;
  font-size: 26rpx;
  border-radius: 20rpx;
}