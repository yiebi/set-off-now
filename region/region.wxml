<image class="page-bg" src="/images/bg.jpg" mode="aspectFill"></image>
<view class="region">
  <view class="head">
    <view class="head-title">家乡发现</view>
    <view class="head-sub">全国 {{cityTotal}} 个城市 · 同学真实评价</view>
  </view>

  <!-- 搜索 -->
  <view class="search-box">
    <view class="search-ico"></view>
    <input class="search-input" placeholder="搜索城市，如 杭州 / 大理 / 阿勒泰" placeholder-class="ph" value="{{keyword}}" bindinput="onKeyword" />
    <view class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">✕</view>
  </view>

  <!-- 搜索结果 -->
  <view class="card" wx:if="{{keyword}}">
    <view class="section-title">搜索结果 · {{searchResult.length}}</view>
    <view wx:for="{{searchResult}}" wx:key="key"
      class="city-row"
      data-city="{{item.city}}" data-province="{{item.province}}"
      bindtap="goCity">
      <view class="city-main">
        <view class="city-name">{{item.city}}</view>
        <view class="muted">{{item.province}}</view>
      </view>
      <view class="city-right"><text class="muted">看评价</text><text class="arrow">›</text></view>
    </view>
    <view class="empty" wx:if="{{searchResult.length === 0}}">没搜到这个城市，换个关键词试试</view>
  </view>

  <!-- 省份总览（34 个） -->
  <view class="card" wx:if="{{!keyword && !activeProvince}}">
    <view class="section-head">
      <view class="section-title">全国省份</view>
      <view class="muted">{{provinces.length}} 个省级行政区</view>
    </view>
    <view class="province-grid">
      <view wx:for="{{provinces}}" wx:key="name"
        class="province-item"
        data-name="{{item.name}}"
        bindtap="pickProvince">
        <text class="province-name">{{item.name}}</text>
        <text class="province-count">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 某省下的城市 -->
  <view class="card" wx:if="{{activeProvince}}">
    <view class="province-nav">
      <view class="back-btn" bindtap="backProvince">
        <text class="back-icon">‹</text>
      </view>
      <view class="section-title">{{activeProvince}}</view>
    </view>
    <view class="muted city-count">{{cityList.length}} 个城市 · 点城市看当地评价</view>
    <view class="city-wrap">
      <view wx:for="{{cityList}}" wx:key="*this"
        class="city-pill"
        data-city="{{item}}" data-province="{{activeProvince}}"
        bindtap="goCity">{{item}}</view>
    </view>
  </view>

  <!-- 有真实评价的城市 -->
  <view class="card" wx:if="{{!keyword && !activeProvince}}">
    <view class="section-head">
      <view class="section-title">已有同学评价的城市</view>
      <view class="muted">点进去看帖子</view>
    </view>
    <view wx:for="{{hotCities}}" wx:key="city"
      class="city-row"
      data-city="{{item.city}}" data-province="{{item.province}}"
      bindtap="goCity">
      <view class="city-main">
        <view class="city-name">{{item.city}}</view>
        <view class="muted">{{item.province}}</view>
      </view>
      <view class="city-right">
        <text class="muted">{{item.count}}条</text>
        <text class="trend {{item.trend==='安利居多'?'trend-good':item.trend==='避雷较多'?'trend-avoid':'trend-mid'}}">{{item.trend}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 家乡专区（我的真实家乡） -->
  <view class="card" wx:if="{{!keyword && !activeProvince}}">
    <view class="section-head">
      <view class="section-title">家乡专区</view>
      <view class="muted">看看同乡同学怎么说</view>
    </view>

    <view wx:if="{{myHometownCity}}" class="home-row" bindtap="goMyHometown">
      <text>📍 我的家乡：{{myHometownProvince}} · {{myHometownCity}}</text>
      <view class="city-right">
        <text class="muted">看同乡帖子</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view wx:else class="home-row" bindtap="goMine">
      <text>📍 还没有设置家乡</text>
      <view class="city-right">
        <text class="muted">去补充</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>