<view class="container">
  <image class="bg-img" src="/images/star_bg.jpg" mode="aspectFill"></image>
  <view class="login-wrap">
    <view class="card">
      <view class="input-item">
        <input placeholder="请输入学号" value="{{studentNo}}" bindinput="onStudentNoInput"/>
      </view>
      <view class="input-item pwd-wrap">
        <input placeholder="请输入密码" password="{{!pwdShow}}" value="{{password}}" bindinput="onPasswordInput"/>
        <view class="eye" bindtap="togglePwd">
          {{ pwdShow ? '👁' : '🚫' }}
        </view>
      </view>
      <view class="input-item pwd-wrap" wx:if="{{isRegister}}">
        <input placeholder="请确认密码" password="{{!confirmPwdShow}}" value="{{confirmPwd}}" bindinput="onConfirmPwdInput"/>
        <view class="eye" bindtap="toggleConfirmPwd">
          {{ confirmPwdShow ? '👁' : '🚫' }}
        </view>
      </view>
      <view class="input-item" wx:if="{{isRegister}}">
        <input placeholder="请输入昵称（1-12字）" value="{{nickname}}" bindinput="onNicknameInput"/>
      </view>

      <view class="tip-text">系统将校验学号是否属于本校，非本校学生无法进入</view>

      <view class="agree-row">
        <checkbox-group bindchange="onAgreeChange">
          <checkbox value="ok" checked="{{agree}}"/>
        </checkbox-group>
        <text>我已阅读并同意《社区真实评价公约》</text>
      </view>

      <button class="submit-btn" bindtap="submit" loading="{{loading}}">
        {{ isRegister ? '注册并进入' : '登录并进入' }}
      </button>

      <view class="switch-txt" bindtap="toggleMode">
        {{ isRegister ? '已有账号？点击登录' : '没有账号？点击注册' }}
      </view>
    </view>
    <view class="footer-txt">仅限杭州电子科技大学在校学生使用 · 真实 · 避雷 · 不接广告</view>
  </view>
</view>