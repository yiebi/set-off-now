.home {
  padding-bottom: 200rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.brand-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 32rpx 8rpx;
}
.brand-name { font-size: 40rpx; font-weight: 800; color: #ffffff; text-shadow: 0 2rpx 10rpx rgba(0,60,20,.35); }
.brand-sub { font-size: 22rpx; color: #f2fff7; margin-top: 6rpx; text-shadow: 0 2rpx 8rpx rgba(0,60,20,.3); }
.bell { font-size: 38rpx; }

.search-box {
  display: flex; align-items: center;
  margin: 18rpx 28rpx; padding: 10rpx 12rpx 10rpx 28rpx;
  background: rgba(255,255,255,0.9); border-radius: 999rpx;
}
.search-input { flex: 1; font-size: 28rpx; }
.search-btn {
  background: #16a34a; color: #fff; font-size: 26rpx;
  padding: 14rpx 32rpx; border-radius: 999rpx;
}

.post { display: block; }
.post-head { display: flex; align-items: flex-start; }
.post-title { font-size: 32rpx; font-weight: 700; line-height: 1.5; flex: 1; }
.post-meta { display: flex; justify-content: space-between; margin-top: 16rpx; color: #8a9a90; font-size: 24rpx; flex-wrap: wrap; }
.post-loc { color: #16a34a; }
.post-tags { margin-top: 16rpx; }
.mini-tag {
  display: inline-block; background: #eef7f2; color: #3f6b52;
  font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 10rpx; margin-right: 14rpx;
}
.post-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; }
.map-thumb {
  width: 96rpx; height: 96rpx; border-radius: 16rpx;
  background: #dcefe4; display: flex; align-items: center; justify-content: center; font-size: 44rpx;
}
.empty { text-align: center; color: #9bb0a6; padding: 80rpx 0; font-size: 26rpx; }

/* 地区筛选横向滚动 */
.chip-scroll { white-space: nowrap; width: 100%; }
.chip-row-inline { display: inline-flex; flex-wrap: nowrap; padding: 10rpx 28rpx 10rpx 28rpx; }

/* 城市筛选提示条 */
.city-filter {
  display: flex;
  align-items: center;
  margin: 4rpx 28rpx;
  padding: 12rpx 26rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #2f5041;
}
.city-filter-label { color: #8a9a90; margin-right: 10rpx; }
.city-filter-name { font-weight: 700; flex: 1; }
.city-filter-clear { color: #16a34a; margin-left: 12rpx; }

/* 我的家乡 chip 高亮 */
.chip.my-home {
  background: #dcfce7;
  color: #16a34a;
  font-weight: 700;
}