.mine {
  padding-bottom: 200rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}
.profile { display: flex; align-items: center; }
.avatar { width: 110rpx; height: 110rpx; border-radius: 50%; background: #dcefe4; display: flex; align-items: center; justify-content: center; font-size: 52rpx; margin-right: 24rpx; }
.profile-info { flex: 1; }
.name-row { display: flex; align-items: center; }
.nickname { font-size: 34rpx; font-weight: 700; margin-right: 16rpx; }
.bind-tag { font-size: 20rpx; color: #16a34a; background: #dcfce7; padding: 4rpx 14rpx; border-radius: 10rpx; }

.stats { display: flex; align-items: center; text-align: center; margin-bottom: 24rpx; }
.stat { flex: 1; }
.stat-num { font-size: 36rpx; font-weight: 800; }
.stat-div { width: 2rpx; height: 60rpx; background: #eef2ef; }

.my-tabs { margin-bottom: 16rpx; }
.my-post { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid #eef2ef; }
.my-post-body { flex: 1; margin-left: 16rpx; }
.my-post-title { font-size: 28rpx; font-weight: 600; }

.menu-row { display: flex; justify-content: space-between; align-items: center; padding: 26rpx 0; }
.menu-text { font-size: 28rpx; }
.arrow { font-size: 32rpx; color: #b6c6bd; }
.menu-icon { margin-right: 12rpx; font-size: 28rpx; }
.empty { text-align: center; color: #9bb0a6; padding: 60rpx 0; font-size: 26rpx; }

/* 主标签：我的帖子 / 我的评论 / 点赞 */
.main-tabs {
  display: flex;
  margin-bottom: 20rpx;
  border-bottom: 2rpx solid #eef2ef;
}
.main-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #7d9689;
  white-space: nowrap;
}
.main-tab-active {
  color: #16a34a;
  font-weight: 700;
  border-bottom: 4rpx solid #16a34a;
}

/* 我的家乡卡片 —— 宽度跟随全局 .card，只压紧垂直高度 */
.hometown-card .menu-row {
  padding: 14rpx 0;
  min-height: 0;
}
.hometown-card picker {
  display: block;
  width: 100%;
}
.hometown-card .menu-text {
  font-size: 28rpx;
}
.hometown-set {
  font-size: 26rpx;
  color: #16a34a;
  font-weight: 600;
}

.muted {
  color: #8a9c93;
  font-size: 26rpx;
}