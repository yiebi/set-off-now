.detail { padding-bottom: 160rpx; }
.post-head { display: flex; align-items: flex-start; }
.post-title { font-size: 32rpx; font-weight: 700; line-height: 1.5; flex: 1; }
.post-meta { display: flex; justify-content: space-between; margin-top: 16rpx; color: #8a9a90; font-size: 24rpx; flex-wrap: wrap; }
.post-loc { color: #16a34a; }
.content { margin-top: 20rpx; font-size: 28rpx; line-height: 1.7; color: #23483a; }
.map-placeholder { height: 180rpx; border-radius: 20rpx; background: #e6f2ec; display: flex; align-items: center; justify-content: center; color: #7d9689; font-size: 26rpx; margin-top: 20rpx; }
.section-title { font-size: 32rpx; font-weight: 700; margin-bottom: 16rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.poll-row { padding: 18rpx 0; }
.poll-label { display: inline-block; padding: 12rpx 24rpx; border-radius: 12rpx; background: #f0f7f2; font-size: 26rpx; color: #2f5041; }
.poll-active { background: #16a34a; color: #fff; }
.poll-count { float: right; color: #8a9a90; font-size: 24rpx; }
.poll-bar { height: 10rpx; background: #eef2ef; border-radius: 999rpx; margin-top: 12rpx; overflow: hidden; }
.poll-fill { height: 100%; background: #16a34a; border-radius: 999rpx; }
.comment { padding: 18rpx 0; border-bottom: 2rpx solid #eef2ef; }
.comment-head { font-size: 24rpx; color: #8a9a90; margin-bottom: 8rpx; }
.comment-text { font-size: 28rpx; color: #23483a; }
.reply-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; padding: 18rpx 28rpx; background: #fff; border-top: 2rpx solid #eef2ef; }
.reply-input { flex: 1; background: #f0f7f2; border-radius: 999rpx; padding: 18rpx 26rpx; font-size: 28rpx; }
.send-btn { margin-left: 16rpx; width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center; background: #16a34a; color: #fff; border-radius: 50%; font-size: 32rpx; }
.empty { text-align: center; color: #9bb0a6; padding: 120rpx 0; font-size: 26rpx; }

/* 点赞 */
.like-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.like-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #f0f7f2;
  border: 2rpx solid #dfeee5;
}

.like-btn .like-icon {
  font-size: 32rpx;
  color: #8a9a90;
  margin-right: 8rpx;
}

.like-btn .like-num {
  font-size: 24rpx;
  color: #7d9689;
}

.like-btn.liked {
  background: #eaf6ee;
  border-color: #16a34a;
}

.like-btn.liked .like-icon {
  color: #e15b64;
}

.like-btn.liked .like-num {
  color: #16a34a;
}